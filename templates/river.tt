<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>[% title | html %]</title>
<style>
  :root {
    --ink: #1a1d24;
    --muted: #6b7280;
    --hair: #e6e8ec;
    --ground: #fbfbfa;
    --card: #ffffff;
    --link: #2f5d8c;
    --flickr: #ff0084;
    --last-fm: #d51007;
    --pinboard: #0000e6;
    --letterboxd: #00b020;
    --spotify: #1db954;
    --github: #24292f;
    --accent: #6b7280;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.5;
  }
  .wrap { max-width: 680px; margin: 0 auto; padding: 40px 20px 72px; }

  header.masthead { margin-bottom: 28px; }
  h1 { font-size: 26px; letter-spacing: -0.02em; margin: 0 0 4px; }
  .masthead .meta { font-family: var(--mono); font-size: 12px; color: var(--muted); }

  .stream { display: flex; flex-direction: column; gap: 2px; }

  .item {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid var(--hair);
  }
  .item:first-child { border-top: none; }

  .badge {
    justify-self: start;
    align-self: start;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
    background: var(--accent);
    border-radius: 5px;
    padding: 3px 8px;
    white-space: nowrap;
  }
  .badge.flickr     { background: var(--flickr); }
  .badge.last-fm    { background: var(--last-fm); }
  .badge.pinboard   { background: var(--pinboard); }
  .badge.letterboxd { background: var(--letterboxd); }
  .badge.spotify    { background: var(--spotify); }
  .badge.github     { background: var(--github); }

  .body .title { font-size: 15.5px; font-weight: 600; margin: 0; }
  .body .title a { color: var(--ink); text-decoration: none; }
  .body .title a:hover { color: var(--link); text-decoration: underline; }
  .body .summary { font-size: 14px; color: #3f4652; margin: 3px 0 0; }
  .body .thumb-link { display: inline-block; margin-top: 8px; }
  .body .thumb { display: block; width: 100%; max-width: 220px; height: auto;
                 border-radius: 6px; border: 1px solid var(--hair); }
  .body time { display: block; font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 6px; }

  .empty { color: var(--muted); font-style: italic; padding: 24px 0; }

  footer.foot { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--hair);
                font-family: var(--mono); font-size: 12px; color: var(--muted); }

  @media (max-width: 480px) {
    .item { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
</head>
<body>
  <div class="wrap">

    <header class="masthead">
      <h1>[% title | html %]</h1>
      <div class="meta">[% count %] entries &middot; updated [% generated_at %]</div>
    </header>

    <main class="stream">
    [% IF items.size %]
      [% FOREACH it IN items %]
      <article class="item">
        <span class="badge [% it.service_class %]">[% it.service | html %]</span>
        <div class="body">
          <p class="title">
            [% IF it.url %]<a href="[% it.url | html %]">[% it.title | html %]</a>
            [% ELSE %][% it.title | html %][% END %]
          </p>
          [% IF it.summary %]<p class="summary">[% it.summary | html %]</p>[% END %]
          [% IF it.image %]<a class="thumb-link" href="[% it.url | html %]"><img class="thumb" src="[% it.image | html %]" alt="" loading="lazy"></a>[% END %]
          <time datetime="[% it.datetime %]" title="[% it.fulldate %]">[% it.when %]</time>
        </div>
      </article>
      [% END %]
    [% ELSE %]
      <p class="empty">No recent activity.</p>
    [% END %]
    </main>

    <footer class="foot">Generated by river.pl</footer>

  </div>
</body>
</html>
